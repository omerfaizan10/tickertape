# Copy to .env.local and fill in for real runs.

# Required for real agent runs. Without it, set MOCK_LLM=true instead.
OPENAI_API_KEY=

DATABASE_URL=postgresql://user:password@host/tickertape

# SEC requires every automated request to identify who is making it, as a
# name plus a contact email. Requests without it are refused.
SEC_USER_AGENT=YourName you@example.com

# Set to true to run the pipeline with deterministic canned agent responses
# instead of calling OpenAI.
MOCK_LLM=false
